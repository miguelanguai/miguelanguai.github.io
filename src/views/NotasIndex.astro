---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { type Lang, formatDate, otherLang, routes, splitId, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const notas = (await getCollection('notas', (n) => n.id.startsWith(`${lang}/`))).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);
---

<Base lang={lang} title={t('notas.title')} alternate={routes.notas[otherLang(lang)]}>
  <h1>{t('notas.title')}</h1>
  <p class="muted">{t('notas.intro')}</p>

  <ul class="list">
    {
      notas.map((n) => (
        <li>
          <time class="mono muted" datetime={n.data.fecha.toISOString()}>
            {formatDate(n.data.fecha, lang)}
          </time>
          <h2>
            <a href={`${routes.notas[lang]}${splitId(n.id).slug}/`}>{n.data.title}</a>
          </h2>
          <p class="muted">{n.data.descripcion}</p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  h1 {
    margin-top: 1.5rem;
  }

  .list {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }

  .list li {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
    margin: 0;
  }

  time {
    font-size: 0.8rem;
  }

  h2 {
    font-size: 1.15rem;
    margin: 0.2rem 0 0.35rem;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .list p {
    margin: 0;
    font-size: 0.95rem;
  }
</style>

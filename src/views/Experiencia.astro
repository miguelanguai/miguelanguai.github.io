---
import Base from '../layouts/Base.astro';
import { type Lang, formatMonth, otherLang, routes, useTranslations } from '../i18n/ui';
import { experiencia } from '../data/experiencia';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} title={t('exp.title')} alternate={routes.experiencia[otherLang(lang)]}>
  <h1>{t('exp.title')}</h1>
  <p class="muted">{t('exp.intro')}</p>

  <ol class="timeline">
    {
      experiencia.map((e) => (
        <li class="job">
          <div class="job-head">
            {e.logo && <img class="logo" src={e.logo} alt="" width="40" height="40" loading="lazy" />}
            <div>
              <h2>
                {e.empresa} {e.practicas && <span class="badge">{t('exp.practicas')}</span>}
              </h2>
              <p class="role">{e.puesto[lang]}</p>
              <p class="mono muted meta">
                {formatMonth(e.inicio, lang)} – {e.fin ? formatMonth(e.fin, lang) : t('exp.actualidad')} · {e.lugar[lang]}
              </p>
            </div>
          </div>
          <ul class="logros">
            {e.logros[lang].map((l) => (
              <li>{l}</li>
            ))}
          </ul>
          <ul class="tags">
            {e.stack.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
          {e.caso && (
            <a class="more-link" href={`${routes.proyectos[lang]}${e.caso}/`}>
              {t('exp.verCaso')} →
            </a>
          )}
        </li>
      ))
    }
  </ol>
</Base>

<style>
  h1 {
    margin-top: 1.5rem;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
  }

  .job {
    padding-bottom: 2.25rem;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid var(--border);
  }

  .job:last-child {
    border-bottom: 0;
  }

  .job-head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    padding: 4px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  h2 {
    font-size: 1.2rem;
    margin-bottom: 0.15rem;
  }

  .role {
    margin: 0;
  }

  .meta {
    margin: 0.15rem 0 0;
  }

  .logros {
    margin-bottom: 1rem;
  }
</style>

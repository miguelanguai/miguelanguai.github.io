---
import { getCollection } from 'astro:content';
import View from '../../../views/Nota.astro';
import { splitId } from '../../../i18n/ui';

export async function getStaticPaths() {
  const entries = await getCollection('notas', (e) => e.id.startsWith('en/'));
  return entries.map((entry) => ({ params: { slug: splitId(entry.id).slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<View lang="en" nota={entry} />
